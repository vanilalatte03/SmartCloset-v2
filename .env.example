OAUTH_STATE_COOKIE_SAME_SITE=Lax
OAUTH_STATE_COOKIE_DOMAIN=
OAUTH_STATE_COOKIE_PATH=/api/auth/oauth2
OAUTH_STATE_COOKIE_MAX_AGE=5m
